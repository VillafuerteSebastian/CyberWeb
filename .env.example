# Environment variables for Cyber-web_Frontend
# Copy this file to .env and adjust the values for your environment.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# Estos valores se obtienen en Supabase -> Project Settings -> API.
# La anon key es pública por diseño (protegida por Row Level Security),
# pero nunca compartas la service_role key desde el frontend.
